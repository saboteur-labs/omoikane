{
  "name": "omoikane",
  "version": "0.1.0",
  "description": "Repository-backed, AI-augmented research and learning tool",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "omoikane": "./dist/omoikane.js"
  },
  "files": [
    "dist/",
    "src/",
    "spec/",
    "scripts/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "dev": "node --import tsx/esm src/cli/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "better-sqlite3": "^12.10.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
